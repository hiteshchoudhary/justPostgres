# --- control plane ---------------------------------------------------------
JP_PORT=3000
JP_HOST=0.0.0.0
JP_DATA_DIR=./data
JP_LOG_LEVEL=info

# Encryption key for project credentials at rest. 32 bytes, base64.
# Generate with: openssl rand -base64 32
# There is no recovery if this is lost: every stored credential becomes unreadable.
JP_MASTER_KEY=

# --- how clients reach the databases ---------------------------------------
# Hostname printed in connection strings. Not the same as JP_HOST, which is only
# the interface the control plane's own HTTP server binds to.
JP_PUBLIC_HOST=localhost

# Host ports available to publish project containers on. This is routing mode 3
# from ARCHITECTURE §5 — the fallback that works before the router lands in M2.
JP_PORT_RANGE_START=55000
JP_PORT_RANGE_END=55999

# --- project defaults ------------------------------------------------------
# {major} is replaced with the project's Postgres major version.
#
# Published images are pulled on first use, so nothing has to be built. Images
# are resolved local-first, so `images/postgres/build.sh` still wins if you have
# built your own — which is what you want when developing.
JP_POSTGRES_IMAGE_TEMPLATE=hiteshchoudhary/justpostgres-postgres:{major}
JP_DEFAULT_PG_MAJOR=17
JP_DEFAULT_PROJECT_MEMORY_MB=512
JP_DEFAULT_PROJECT_CPUS=1
# How long to wait for a new project to accept connections before failing it.
# First boot runs initdb, which is slow on slow disks.
JP_PROJECT_READY_TIMEOUT_MS=120000

# --- auth ------------------------------------------------------------------
# There is no default account. The first boot prints a one-time setup token to
# the log, and /setup will not create the admin account without it — otherwise
# the first stranger to find the page owns the install. Find it with:
#   docker compose logs control-plane | grep jp_setup
# Set this to choose the token yourself (16+ characters), e.g. when provisioning
# with a configuration manager that should hand the operator a known value.
# It is consumed the moment the admin account is created.
# JP_SETUP_TOKEN=

# Proxies whose X-Forwarded-For header is believed, as IPs or CIDR ranges.
# Empty means the header is ignored and the socket address is used, which is
# correct when nothing sits in front. Set it when you put a reverse proxy there,
# or the audit log records the proxy's address for every request.
#
# Do not widen it beyond the proxy. The login lockout is keyed on the client
# address, so anything that can reach the port and is covered by this list can
# forge a different address per attempt and never be rate limited.
# JP_TRUSTED_PROXIES=172.16.0.0/12

JP_SESSION_TTL_HOURS=720
JP_LOGIN_MAX_ATTEMPTS=5
JP_LOGIN_LOCKOUT_MS=60000

# --- docker ----------------------------------------------------------------
# Prefer the socket proxy in docker compose. Left unset in local development,
# the socket is auto-detected (Linux, Docker Desktop on macOS, Colima).
# JP_DOCKER_HOST=tcp://docker-socket-proxy:2375
# JP_DOCKER_SOCKET=/var/run/docker.sock

# --- background work -------------------------------------------------------
JP_RECONCILE_INTERVAL_MS=30000
JP_JOB_POLL_INTERVAL_MS=1000
JP_JOB_LEASE_TTL_MS=30000
JP_JOB_HEARTBEAT_INTERVAL_MS=10000
JP_JOB_CONCURRENCY=2

# --- router (M2) -----------------------------------------------------------
# Session mode: one client connection to one server connection. Use for
# migrations, pg_dump, LISTEN/NOTIFY and long-lived application connections.
JP_ROUTER_SESSION_PORT=5432
# Transaction mode: server connections are pooled across clients. Use for
# serverless. Session state does not survive a transaction here.
JP_ROUTER_POOL_PORT=6543
JP_POOL_SIZE=10
# Statement run when a server connection returns to the pool. Empty by default,
# matching PgBouncer and Supavisor. Set to "DISCARD ALL" to guarantee no session
# state leaks between clients, at the cost of a round trip per transaction.
JP_POOL_RESET_QUERY=

# Wildcard TLS turns on SNI routing: <project-ref>.db.example.com. Without it
# the router answers SSLRequest with 'N' and clients must use the username form
# <role>.<project-ref>.
# JP_ROUTER_TLS_CERT=/etc/justpostgres/tls/fullchain.pem
# JP_ROUTER_TLS_KEY=/etc/justpostgres/tls/privkey.pem
# JP_ROUTER_DOMAIN_SUFFIX=db.example.com

# How the router reaches project containers. On Linux with docker compose this
# is the host gateway; project containers publish their ports there.
JP_ROUTER_BACKEND_HOST=host.docker.internal

# --- data browser (M3) -----------------------------------------------------
# How the control plane reaches a project's Postgres to browse its data. It
# connects to the container directly rather than through the router: the
# browser needs session semantics (cursors, SET, transactions) that transaction
# pooling does not provide, and this way it keeps working if the router is down.
JP_PROJECT_CONNECT_HOST=127.0.0.1
# Every statement the browser or SQL editor issues is bounded by this.
JP_DATA_STATEMENT_TIMEOUT_MS=15000
# Hard cap on rows returned to the UI, whatever the query asked for.
JP_DATA_MAX_ROWS=1000

# --- backups (M4) ----------------------------------------------------------
# One repository per project. Backups are on by default for every project: a
# database tool whose backups are opt-in is a database tool that does not back
# up. See docs/ARCHITECTURE.md §6 for why the repository is per-project.
JP_BACKUP_REPO_TYPE=posix
JP_BACKUP_INTERVAL_HOURS=24
JP_BACKUP_FULL_EVERY_DAYS=7
JP_BACKUP_RETENTION_FULL=4
JP_BACKUP_TIMEOUT_MS=21600000

# The recovery point objective, in seconds: a partly filled WAL segment is
# archived after at most this long, so it bounds how much committed work can be
# lost with the host. Lower is safer and costs little (idle databases do not
# switch segments). Applies to a project when its container is next recreated.
JP_BACKUP_ARCHIVE_TIMEOUT_SECONDS=60

# How often to prove a backup still restores, by actually restoring it into a
# throwaway volume. 0 disables it, which is not recommended: a backup nobody
# has ever restored is a hypothesis.
JP_RESTORE_CHECK_INTERVAL_HOURS=168

# Object storage (S3, Cloudflare R2, or anything S3-compatible) is configured
# from the UI instead: Instance -> Backups in object storage. It walks through
# where to find each value, tests the connection before saving, and stores the
# credentials encrypted with JP_MASTER_KEY. New projects then use it
# automatically, and existing ones move with one button.
#
# These variables still work and take effect for new projects when the UI has
# not been used. They exist for provisioning a host from a configuration
# manager; there is no reason to prefer them otherwise.
#
# The caveat is the same either way: credentials that reach a project container
# reach the whole bucket unless you scope them to a prefix.
# JP_BACKUP_REPO_TYPE=s3
# JP_BACKUP_S3_BUCKET=
# JP_BACKUP_S3_ENDPOINT=
# JP_BACKUP_S3_REGION=us-east-1
# JP_BACKUP_S3_KEY=
# JP_BACKUP_S3_SECRET=

# --- branching (M5) --------------------------------------------------------
# Copy-on-write branching. "none" falls back to a point-in-time restore, which
# works everywhere and costs time proportional to the size of the database.
#
# Mount the filesystem yourself and point JP_COW_ROOT at it — mounting is an
# operator's job; justpostgres only creates and snapshots subvolumes inside it.
#   btrfs:  mkfs.btrfs /dev/sdX && mount /dev/sdX /var/lib/jpcow
#   zfs:    zfs create tank/justpostgres   (untested; see docs/ROADMAP.md M5)
JP_COW_DRIVER=none
# JP_COW_ROOT=/var/lib/jpcow

# How long an unpinned branch lives before it is deleted. 0 disables expiry.
JP_BRANCH_TTL_HOURS=168

# --- REST API (M7) ---------------------------------------------------------
# PostgREST image used for a project's API. Off by default per project.
JP_REST_IMAGE=postgrest/postgrest:latest

# Wildcard domain for the hostname form, <project-ref>.api.example.com.
# Without it the path form /rest/<project-ref>/ is the only address, which
# always works. PostgREST itself is published on loopback only; the control
# plane's proxy is the route in.
# JP_REST_DOMAIN_SUFFIX=api.example.com
