    "dockerode": "^4.0.9",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.9.10",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.44",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.5",
